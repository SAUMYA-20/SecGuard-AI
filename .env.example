# SecGuard AI Environment Configuration

# Server
PORT=4000
NODE_ENV=development

# Google Gemini AI Configuration
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6

# MongoDB Atlas (free M0 tier) - https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/secguard

# Redis (BullMQ distributed queue) - optional for local dev, runs automatically in-memory if Redis is offline
# Run via Docker: docker compose up -d
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT / Auth
JWT_SECRET=your_jwt_secret_key_here

# Rate Limiting
COMMUNITY_DAILY_SCAN_LIMIT=3
